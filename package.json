{
  "name": "pawsrate",
  "version": "1.0.0",
  "description": "PawsRate - Pet food preference tracking prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:css:fix": "npm run lint:css -- --fix",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run type-check && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "open-props": "^1.7.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.66.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
